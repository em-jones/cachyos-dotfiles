{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "enabled": true
    },
    "jcodemunch": {
      "type": "local",
      "command": [
        "jcodemunch-mcp"
      ]
    },
    "jdocmunch": {
      "type": "local",
      "command": [
        "jdocmunch-mcp"
      ]
    },
    "headroom": {
      "type": "local",
      "command": [
        "/home/em/.local/bin/headroom",
        "mcp",
        "serve"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": true
    }
  },
  "provider": {
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  }
}
